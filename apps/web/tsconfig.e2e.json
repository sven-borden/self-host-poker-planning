{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./.tsbuild/e2e",
    // The e2e tests import the protocol version, the leak scan and the domain's results
    // (#20: the numbers on screen must equal them) from their source.
    "rootDir": "../..",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts",
    "src/table/layout.ts",
    "src/table/geometry.ts",
    "../../packages/protocol/src/version.ts",
    "../../packages/protocol/src/leak-scan.ts",
    "../../packages/domain/src/results.ts",
    "../../packages/domain/src/decks.ts"
  ]
}
