{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./.tsbuild/e2e",
    // The e2e tests import the protocol version and the leak scan from their source.
    "rootDir": "../..",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts",
    "src/table/layout.ts",
    "src/table/geometry.ts",
    "../../packages/protocol/src/version.ts",
    "../../packages/protocol/src/leak-scan.ts"
  ]
}
