{
  "name": "poker-planning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && pnpm --parallel --filter @pp/web --filter @pp/server run dev",
    "build": "pnpm --recursive run build",
    "test": "vitest run --project=!db",
    "test:db": "vitest run --project=db --no-file-parallelism",
    "lint": "biome check . && node apps/web/scripts/check-colours.ts",
    "format": "biome check --write .",
    "typecheck": "tsc --build",
    "gate": "node scripts/check-node.mjs && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
