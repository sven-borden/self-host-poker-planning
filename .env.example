# Poker Planning configuration. Copy to `.env` for local development
# (`pnpm --filter @pp/server dev` loads it with Node's --env-file-if-exists); in Docker and
# on Coolify set the variables on the container instead. Every value below is a placeholder:
# never commit a real one. Full list: docs/02-architecture.md, section 12.

# --- Required ---------------------------------------------------------------------------

# Postgres 17 connection string (postgres:// or postgresql://). Holds a password: never log it.
# The server waits up to 30 s for it at start, then applies the migrations.
DATABASE_URL=postgres://postgres:change-me@localhost:5432/poker

# Public origin the browser uses, without a path or credentials: cookies and OAuth callbacks
# are built on it, and Socket.IO refuses a browser handshake from any other Origin. With
# `pnpm dev` the browser is on Vite's port, which forwards the Origin unchanged, so use
# http://localhost:5173; when you run the built server alone (`pnpm start`), use
# http://localhost:3000 (its PORT).
BASE_URL=http://localhost:5173

# Signs the session cookies (Better Auth, #10). Required, at least 32 random characters:
# generate one with `openssl rand -base64 32`. Changing it signs everybody out (guests get
# a new identity). Never log or commit the real value.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters

# --- Optional ---------------------------------------------------------------------------

# HTTP port the server listens on (Socket.IO shares it).
PORT=3000

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# How many reverse proxies stand in front of the server, each appending to X-Forwarded-For:
# the client address (for rate limits, never logged) is the entry that many places from the
# right. true = 1 (Traefik alone, Container Apps); 2 for a TLS proxy in front of Traefik;
# false = 0 when the server faces the internet directly. Too high lets clients forge it.
TRUST_PROXY=true

# Rooms, their history and orphan guests are deleted after this many days without activity.
ROOM_TTL_DAYS=90

# Folder of the built web app. Defaults to apps/web/dist next to the server; the Docker
# image sets its own path.
# STATIC_DIR=/app/public

# Folder of the SQL migrations the server applies at start. Defaults to apps/server/drizzle
# next to the server; the Docker image copies it there or sets its own path.
# MIGRATIONS_DIR=/app/drizzle

# Reported by /api/health. The Docker build sets them; leave unset locally.
# GIT_COMMIT=
# APP_VERSION=

# Scale-out only (#39): enables the Socket.IO Redis adapter.
# REDIS_URL=redis://localhost:6379

# Opt-in observability. Nothing external loads while these are unset.
# SENTRY_DSN=
# UMAMI_URL=
# UMAMI_WEBSITE_ID=

# Social sign-in (W5): the Google and Microsoft provider keys are added here with W5.
