# Poker Planning configuration. Copy to `.env` for local development
# (`pnpm --filter @pp/server dev` loads it with Node's --env-file-if-exists); in Docker and
# on Coolify set the variables on the container instead. Every value below is a placeholder:
# never commit a real one. Full list: docs/02-architecture.md, section 12.

# --- Required ---------------------------------------------------------------------------

# Postgres 17 connection string (postgres:// or postgresql://). Holds a password: never log it.
# The server waits up to 30 s for it at start, then applies the migrations.
DATABASE_URL=postgres://postgres:change-me@localhost:5432/poker

# Public origin the browser uses, without a path or credentials: cookies and OAuth callbacks
# are built on it, and Socket.IO refuses a browser handshake from any other Origin. With
# `pnpm dev` the browser is on Vite's port, which forwards the Origin unchanged, so use
# http://localhost:5173; when you run the built server alone (`pnpm start`), use
# http://localhost:3000 (its PORT).
BASE_URL=http://localhost:5173

# Signs session cookies (#10). At least 32 random characters, for example the output of
# `openssl rand -base64 32`. Changing it signs everybody out (guests get a new identity).
# Left empty on purpose: there is no placeholder that could end up in production by
# accident, and the server refuses a value made of one repeated character.
BETTER_AUTH_SECRET=

# --- Optional ---------------------------------------------------------------------------

# HTTP port the server listens on (Socket.IO shares it).
PORT=3000

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# How many reverse proxies stand in front of the server, each appending to X-Forwarded-For
# (0 to 10): the client address (for rate limits, never logged) is the entry that many
# places from the right. true = 1 (Traefik, nginx, Container Apps alone); 2 for a TLS proxy
# in front of Traefik, once Traefik trusts that proxy; false = 0 when the port faces clients
# directly. Unset means true here (the server's default) and false in compose. Count only
# proxies no client can bypass: a higher number lets clients fake their address.
# TRUST_PROXY=true

# Rooms, their history and orphan guests are deleted after this many days without activity.
ROOM_TTL_DAYS=90

# Only to run several instances behind one address (README, "Running several instances"):
# a Redis 6.2 or newer that every instance reaches. The instances then share room changes,
# presence and command ids through it, and sockets use WebSocket only. Leave unset for one
# instance: nothing about Redis is loaded. May hold a password; the server never logs it.
# REDIS_URL=redis://redis:6379

# Folder of the built web app. Defaults to apps/web/dist next to the server; the Docker
# image sets its own path.
# STATIC_DIR=/app/public

# Folder of the SQL migrations the server applies at start. Defaults to apps/server/drizzle
# next to the server; the Docker image copies it there or sets its own path.
# MIGRATIONS_DIR=/app/drizzle

# Reported by /api/health. The Docker build sets them; leave unset locally.
# GIT_COMMIT=
# APP_VERSION=

# Scale-out only (#39): enables the Socket.IO Redis adapter.
# REDIS_URL=redis://localhost:6379

# Opt-in observability (#40). Nothing external loads while these are unset.
# Error reports from the server and the page; a DSN with its public key only.
# SENTRY_DSN=https://0123abcd@o0.ingest.sentry.io/0
# Page views, by route (a room is /r/:code): Umami's address, under which the tracker is
# /script.js (or the tracker's own URL if you renamed it), and the website's id. Both or
# neither.
# UMAMI_URL=https://stats.example.com
# UMAMI_WEBSITE_ID=

# Sign-in with Google and Microsoft (#47), each off until both its keys are set; one of the two
# alone stops the server at start. Nothing is required: everyone can play as a guest. The
# README's "Signing in with Google or Microsoft" has the console steps. Redirect URIs:
# <BASE_URL>/api/auth/callback/google and <BASE_URL>/api/auth/callback/microsoft.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Who may sign in with Microsoft: common (the default), organizations, consumers or a tenant's id.
# MICROSOFT_TENANT_ID=common

# The key of the connectors' tokens (Jira, Azure DevOps): 32 random bytes in base64, from
# `openssl rand -base64 32`, never the value of BETTER_AUTH_SECRET. Empty, the vault is off.
# Keep it apart from your database backups. The README's "Connector tokens" has the steps to
# change it: the previous key moves to POKER_VAULT_OLD_KEYS (commas between several) until
# `node dist/main.mjs vault:rotate` has moved every token to the new one. After editing this file
# run `docker compose up -d`: `docker compose restart` keeps the old values.
# POKER_VAULT_KEY=
# POKER_VAULT_OLD_KEYS=

# The Azure DevOps connector: on only with exactly `on`, and it also needs POKER_VAULT_KEY above and
# a sign-in provider. It holds no key, and each person brings a token: this says that you want a
# form that keeps people's own Microsoft tokens on this server. Any other value leaves it off. The
# README's "Azure DevOps" has the steps.
# AZURE_DEVOPS_CONNECTOR=on

# The Jira Cloud connector: an OAuth 2.0 (3LO) app from https://developer.atlassian.com/console/myapps/,
# both or neither. It also needs POKER_VAULT_KEY above and a sign-in provider: with any of them
# missing no button shows and the routes answer as absent. The README's "Jira Cloud" has the
# steps, the scopes and the redirect URI, which is BASE_URL + /api/connectors/jira/callback.
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=

# --- Docker Compose (compose.yaml) ------------------------------------------------------
# Compose reads this file only to fill in compose.yaml. It builds DATABASE_URL itself from
# the bundled Postgres (DATABASE_URL above is ignored there). BASE_URL must be the address
# people open (http://localhost:3000 on your machine, your https:// origin on a server;
# the README writes it for you), BETTER_AUTH_SECRET must be set, and TRUST_PROXY defaults
# to false (see above). GIT_COMMIT and APP_VERSION above become build arguments.

# Password of the bundled Postgres, required by compose. It goes into a URL, so use letters
# and digits only, for example the output of `openssl rand -hex 24`. Postgres keeps the
# password of its first start: changing it later needs ALTER USER in the database too.
POSTGRES_PASSWORD=
